{
  "name": "step-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Edge/Chromium extension that records a workflow as a step-by-step guide with screenshots.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=120000 \"test/e2e/*.test.mjs\"",
    "build": "node scripts/pack.mjs",
    "check:versions": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run check:versions && npm test && npm run build",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1"
  }
}
